APP_NAME="Ateliê Ilma Guerra - Atendimento"
APP_VERSION=1.0.0
DEBUG=false

# MESMO arquivo do backend de gestão — clientes e usuários são compartilhados.
# Na VM: /var/www/atelie/app_dev/backend/database/atelie.db
DATABASE_PATH=/var/www/atelie/app_dev/backend/database/atelie.db

# Fotos vão para o diretório do gestão, para a URL continuar válida depois que
# o atendimento vira pedido.
UPLOADS_DIR=/var/www/atelie/app_dev/backend/uploads

BACKEND_CORS_ORIGINS=https://atendimento.atelieilmaguerra.com.br
HOST=0.0.0.0
PORT=8002

# OBRIGATÓRIO ser diferente do JWT_SECRET_KEY do app de gestão. É o que impede
# um token deste site de valer lá. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-um-segredo-proprio-diferente-do-gestao
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
