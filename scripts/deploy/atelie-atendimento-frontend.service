[Unit]
Description=Ateliê Ilma Guerra - Frontend do site de atendimento
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/atelie/app_atendimento/frontend
Environment="NODE_ENV=production"
Environment="PORT=3005"
ExecStart=/usr/bin/npm start

PrivateTmp=true
NoNewPrivileges=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
